# Streamlit Cloud Secrets 등록 양식
# 실제 사용: 이 파일을 그대로 복사해서 Streamlit Cloud 웹 UI의
# "Settings → Secrets" 입력란에 붙여넣기 (값은 실제 키로 채움)
#
# 로컬 테스트 시: _workspace/.env 그대로 사용
# Streamlit Cloud 에서는 .env 대신 secrets.toml 자동 인식

[api_keys]
KRX_API_KEY = "여기에_KRX_OpenAPI_키"
DART_API_KEY = "여기에_DART_OpenAPI_키"
FNSPACE_API_KEY = "여기에_FnSpace_API_키"
FRED_API_KEY = "여기에_FRED_API_키"
NAVER_CLIENT_ID = "여기에_네이버_클라이언트_ID"
NAVER_CLIENT_SECRET = "여기에_네이버_시크릿"
GITHUB_TOKEN = "여기에_깃허브_토큰"
